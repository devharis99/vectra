#!/usr/bin/env bash
# Vectra CLI entrypoint launcher

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

CANDIDATES=(
    "$SCRIPT_DIR"
    "/home/abrham/projects/vectra"
    "/home/abrham/projectss/vectra"
    "/home/abrham/Projects/vectra"
)

for dir in "${CANDIDATES[@]}"; do
    if [ -f "$dir/.venv/bin/python3" ]; then
        exec "$dir/.venv/bin/python3" -m vectra.cli "$@"
    fi
done

if command -v python3 &>/dev/null && python3 -c "import vectra" &>/dev/null; then
    exec python3 -m vectra.cli "$@"
fi

echo "Error: Vectra virtual environment not found." >&2
echo "Run: cd $SCRIPT_DIR && python3 -m venv .venv && source .venv/bin/activate && pip install -e ." >&2
exit 1
